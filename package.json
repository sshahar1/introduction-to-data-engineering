{
  "name": "introduction-to-data-engineering",
  "description": "Introduction to data engineering presentation with Astro",
  "version": "2.0.0",
  "author": "Sigal Shaharabani <sigals@tikalk.com>",
  "dependencies": {
    "astro": "^7.4.2"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "keywords": [
    "astro",
    "presentation"
  ],
  "license": "MIT",
  "main": "n/a",
  "scripts": {
    "clean": "rm -rf dist .astro node_modules/.astro",
    "prepare": "husky",
    "build": "astro build",
    "develop": "astro dev --port 8000",
    "serve": "astro preview --port 8000",
    "format": "prettier --write \"src/**/*.{js,astro}\" \"*.mjs\"",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^4.0.0",
    "@typescript-eslint/parser": "^4.0.0",
    "babel-eslint": "^10.0.0",
    "eslint": "^9.26.0",
    "husky": "^9.1.6",
    "prettier": "^3.3.3",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^4.0.0"
  }
}
