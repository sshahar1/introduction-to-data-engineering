{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "netlify-mcp": {
      "type": "http",
      "url": "https://netlify-mcp.netlify.app/mcp"
    }
  },
  "tools": {
    "github": {
      "type": "github",
      "tokenEnv": "GITHUB_TOKEN",
      "owner": "GITHUB_OWNER",
      "repo": "GITHUB_REPO",
      "baseUrl": "https://api.github.com"
    }
  }
}
