# Security headers, carried over from the Gatsby deployment (constitution:
# MUST NOT be loosened without a recorded rationale). Everything is
# same-origin; 'unsafe-inline' is needed for Astro's inlined styles and the
# client router's transition styles.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: same-origin
  X-XSS-Protection: 1; mode=block

# Hashed build assets never change
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Browsers must always fetch the latest worker script (see sw.js)
/sw.js
  Cache-Control: no-cache
